{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Denarmo/emulator-control-protocol/main/schema/results/screenshot.schema.json",
  "title": "result of screenshot: image inline, or path when the request gave one",
  "$ref": "../common.schema.json#/$defs/result",
  "properties": {
    "image": {
      "$ref": "../common.schema.json#/$defs/picture"
    },
    "path": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "ok": {
        "const": true
      }
    },
    "required": [
      "ok"
    ]
  },
  "then": {
    "anyOf": [
      {
        "required": [
          "image"
        ]
      },
      {
        "required": [
          "path"
        ]
      }
    ]
  }
}
