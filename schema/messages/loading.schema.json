{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Denarmo/emulator-control-protocol/main/schema/messages/loading.schema.json",
  "title": "loading (event)",
  "type": "object",
  "required": [
    "type"
  ],
  "properties": {
    "type": {
      "const": "loading"
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "text": {
      "type": "string"
    }
  }
}
