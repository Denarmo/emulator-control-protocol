{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Denarmo/emulator-control-protocol/main/schema/messages/auth.schema.json",
  "title": "auth (engine to frontend, TCP only, first frame)",
  "type": "object",
  "required": [
    "type",
    "token"
  ],
  "properties": {
    "type": {
      "const": "auth"
    },
    "token": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
