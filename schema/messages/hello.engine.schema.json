{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Denarmo/emulator-control-protocol/main/schema/messages/hello.engine.schema.json",
  "title": "hello (engine to frontend): the descriptor plus type and protocol",
  "allOf": [
    {
      "$ref": "../descriptor.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "type",
    "protocol"
  ],
  "properties": {
    "type": {
      "const": "hello"
    },
    "protocol": {
      "const": 1
    }
  }
}
