{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Denarmo/emulator-control-protocol/main/schema/messages/paused.schema.json",
  "title": "paused (event)",
  "type": "object",
  "required": [
    "type",
    "reason"
  ],
  "properties": {
    "type": {
      "const": "paused"
    },
    "reason": {
      "enum": [
        "frontend",
        "menu",
        "focus",
        "applet"
      ]
    }
  }
}
