{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Denarmo/emulator-control-protocol/main/schema/messages/set_volume.schema.json",
  "title": "set_volume (request)",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "type": {
      "const": "set_volume"
    },
    "id": {
      "$ref": "../common.schema.json#/$defs/request_id"
    },
    "percent": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "mute": {
      "type": "boolean"
    }
  }
}
